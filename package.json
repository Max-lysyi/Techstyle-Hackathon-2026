    "test:parts:api": "node tests/part-locations-api.cjs",
    "test:assets:api": "node tests/asset-reconstruction-api.cjs",
    "test:tiff": "node tests/tiff-export.cjs",
    "test:grounding:api": "node tests/artwork-grounding-api.cjs",
