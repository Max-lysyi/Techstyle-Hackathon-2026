# Скопіюйте в .env.local і додайте серверний ключ OpenAI.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6.1-terra
# Fast approximate garment-part localization for the single-action workflow.
OPENAI_PARTS_MODEL=gpt-5.4
# Vision request deadline (1000–120000 ms); no automatic paid retries.
OPENAI_VISION_TIMEOUT_MS=90000

# Для плоского дизайну, поділу на шари та AI-відновлення: gpt-image-2.5-flare або gpt-image-2.5-sunburst
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Якість реконструкції: low / medium / high
OPENAI_IMAGE_QUALITY=high
# Python із scripts/cv/requirements.txt
CV_PYTHON=python3

# Timeout одного етапу генерації (мілісекунди, максимум 300000)
OPENAI_DESIGN_TIMEOUT_MS=240000

# Local hourly Images Edit budget. Each part uses 2 calls; cache hits do not count.
OPENAI_DESIGN_REQUESTS_PER_HOUR=40

# Reconstruction of individual emblems/numbers: transparent PNG, explicitly approved.
OPENAI_ASSET_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_ASSET_IMAGE_QUALITY=high
OPENAI_ASSET_TIMEOUT_MS=240000

# Detailed crop verification model; each paid verification counts toward Vision budget.
OPENAI_ASSET_VISION_MODEL=gpt-5.4
